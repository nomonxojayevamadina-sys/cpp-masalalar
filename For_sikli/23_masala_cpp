// kiriitlgan tengsizlik hadini topish dasturi ( a1 = 1 & a2 = 2 ) bo'lganda 
#include <iostream>

#include <math.h>

using namespace std;

int main() {
    int n ; float a; 
    float a1 = 1 , a2 = 2 ; 
    cout<<"kiritilgan ketma ketlik hadlari aniqlanadi!!!"<<endl;
    cout<<"A1 = 1 "<<"         "<<"A2 = 2"<<endl;
    cout<<"n= "<<endl; cin>>n;
    for ( int i = 3 ; i<=n ; i++) {
        a = (a1+a2*2)/3 ; 
        a1= a2 ; 
        a2= a;
        cout<<a<<"  ";
    }
    return 0 ; 
}

