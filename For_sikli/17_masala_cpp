// 1.1*1.2*1.3........n ta ko'paytuvchi hisoblovchi dastur tizilsin!
#include <iostream>

using namespace std;

int main() {
    int n; 
    double s = 1.0;
    
    cout << "(n>0) n = ";
    cin >> n;
    
    for (int i = 1; i <= n; i++) {
        s *= (1.0 + i * 0.1);
    }
    
    cout << "Ko'paytma: " << s << endl;
    return 0;
}
