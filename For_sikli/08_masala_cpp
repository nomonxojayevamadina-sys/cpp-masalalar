// a dan b gacha bo'lgan barcha sonlar ko'paytmasini aniqlovchi dastur 
#include <iostream>

using namespace std;

int main() {
  int a, b, p = 1;
  cout<<"sonlar ko'paytmasi aniqlanadi!!"<<endl;
  cout<<"a="<<endl; cin>>a;
  cout<<"b="<<endl; cin>>b;
  for ( int i = 1 ; i<=b ; i++) {
    p *= i;
  }
  cout<<"barcha sonlar ko'paytmasi: "<<p;
  return 0;
}
